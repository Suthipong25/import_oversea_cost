# PostgreSQL connection string for Perkin Server (pgAdmin) or local Docker Postgres
# Example (Perkin LAN server): postgresql://postgres:YOUR_PASSWORD@192.168.x.x:5432/perkin_freightrate
# Example (Local Docker):      postgresql://postgres:postgres@localhost:5432/perkin_freightrate
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/perkin_freightrate"

# Secret used to sign session cookies & private file download URLs (min 32 random chars)
APP_SECRET="change-me-to-a-long-random-32-char-secret-key"

# Private directory for uploaded supplier rate files (PDFs / images)
STORAGE_ROOT="./storage"

# Default initial password for seeded test accounts (change in production!)
SEED_DEFAULT_PASSWORD="Perkin2026!"

# Optional AI API Keys for Vision / PDF / Chat extraction (set at least one to enable LLM extraction)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
